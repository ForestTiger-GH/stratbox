{"unit_id":"SB-MAT-0554-ONT-15","source_id":"SB-SRC-0554","source_blob_sha":"ffe6e24dfa3e542f278b7afa3dbeff09b637b935","source_span":"L781","english_research_meaning":"AI-facing read-only/tool metadata is a declaration, not enforcement of actual effects or permissions at runtime.","science_id":"SB-SRC-0554/ONT-15","science_destination":"docs/science/capabilities/composition-identity-and-user-machine-projections.md","source_language":"ru","epistemic_status":"LATE_RESEARCH_ONTOLOGY_ALTERNATIVE_NOT_PRODUCT_APPROVED","disposition":"MACHINE_METADATA_NONIMPLICATION","independent_review":"OPEN","source_material_state":"unaccounted","original_user_comment_basis":"RESEARCH_ONLY_OR_PRIMARY_TEXT_SOME_WITH_RAW_DOCX_SHA_UNVERIFIED"}
{"unit_id":"SB-MAT-0554-ONT-16","source_id":"SB-SRC-0554","source_blob_sha":"ffe6e24dfa3e542f278b7afa3dbeff09b637b935","source_span":"L791","english_research_meaning":"An agent-authored plan is not an admitted execution plan; binding must validate actual capability, input schema, permissions, versions and risk limits.","science_id":"SB-SRC-0554/ONT-16","science_destination":"docs/science/capabilities/composition-identity-and-user-machine-projections.md","source_language":"ru","epistemic_status":"LATE_RESEARCH_ONTOLOGY_ALTERNATIVE_NOT_PRODUCT_APPROVED","disposition":"AGENT_PLAN_ADMISSION_BOUNDARY","independent_review":"OPEN","source_material_state":"unaccounted","original_user_comment_basis":"RESEARCH_ONLY_OR_PRIMARY_TEXT_SOME_WITH_RAW_DOCX_SHA_UNVERIFIED"}
