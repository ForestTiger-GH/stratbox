{"unit_id":"SB-MAT-0558-SEC-01","source_id":"SB-SRC-0558","source_blob_sha":"68e433f98e9f660c1c5738ef8a41e077ac738a95","source_span":"L165","english_research_meaning":"Permission strength should follow the actual threat profile, not a generic claim that the application is internal.","science_id":"SB-SRC-0558/SEC-01","science_destination":"docs/science/trust-and-assurance/identity-authorization-and-effect-boundaries.md","source_language":"ru","epistemic_status":"RESEARCH_THREAT_MODEL_CANDIDATE_NOT_SECURITY_CERTIFICATION","disposition":"DEPLOYMENT_THREAT_SCOPE","independent_review":"OPEN","source_material_state":"unaccounted"}
