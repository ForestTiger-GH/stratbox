{"unit_id":"SB-MAT-0558-SEC-04","source_id":"SB-SRC-0558","source_blob_sha":"68e433f98e9f660c1c5738ef8a41e077ac738a95","source_span":"L173","english_research_meaning":"An AI/machine caller needs scoped delegation and effect admission rather than unconditional script or filesystem access.","science_id":"SB-SRC-0558/SEC-04","science_destination":"docs/science/trust-and-assurance/identity-authorization-and-effect-boundaries.md","source_language":"ru","epistemic_status":"RESEARCH_THREAT_MODEL_CANDIDATE_NOT_SECURITY_CERTIFICATION","disposition":"AGENT_DELEGATION_LIMIT","independent_review":"OPEN","source_material_state":"unaccounted"}
{"unit_id":"SB-MAT-0558-SEC-05","source_id":"SB-SRC-0558","source_blob_sha":"68e433f98e9f660c1c5738ef8a41e077ac738a95","source_span":"L175","english_research_meaning":"An attacker with host administrator powers or arbitrary in-process trusted Python is outside the protection of an application-only role table.","science_id":"SB-SRC-0558/SEC-05","science_destination":"docs/science/trust-and-assurance/identity-authorization-and-effect-boundaries.md","source_language":"ru","epistemic_status":"RESEARCH_THREAT_MODEL_CANDIDATE_NOT_SECURITY_CERTIFICATION","disposition":"OS_PROCESS_BOUNDARY","independent_review":"OPEN","source_material_state":"unaccounted"}
